# ---------------------------------------------------------------------------
# BabiPlay — exemple de configuration locale
# Copier ce fichier vers .env.local puis adapter les valeurs.
# Ne JAMAIS commiter .env.local ni une clé réelle.
# ---------------------------------------------------------------------------

# Mode de l'application : demo | local
VITE_APP_MODE=demo

# Paiements : laisser false tant que l'API officielle n'est pas intégrée.
VITE_PAYMENT_ENABLED=false

# Fournisseur de paiement (nom logique, pas une clé)
VITE_PAYMENT_PROVIDER=disabled
VITE_PAYMENT_SANDBOX=true

# ---------------------------------------------------------------------------
# Variables SERVEUR uniquement (Edge Functions / backend).
# Ne jamais préfixer par VITE_ : tout ce qui commence par VITE_ est public.
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=
# PAYMENT_API_BASE_URL=
# PAYMENT_PUBLIC_KEY=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Supabase (optionnel — laisser vide pour rester en mode démonstration locale)
# Copier ce fichier vers .env.local puis coller l'URL du projet et la clé
# "anon" (publique). La clé service_role ne doit JAMAIS être préfixée VITE_.
# Voir supabase/README.md pour la procédure complète.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVEUR uniquement — ne jamais exposer côté client.
# SUPABASE_SERVICE_ROLE_KEY=
